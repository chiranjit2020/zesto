# Copy to .env.local (gitignored) for local dev. See docs/NOTIFICATIONS_PLAN.md.
#
# All VITE_-prefixed vars are bundled into the client build — this is the public Firebase
# web config, which is not a secret by design (Firebase authorizes via security rules /
# App Check, not by hiding this key). Nothing below this section is safe to expose:
# MongoDB, the Admin SDK key and the cron secret live only in Vercel's environment
# variables and this repo's GitHub Actions secrets, never in a client env file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Optional — enables Firebase Analytics (spec §19). Unset just means analytics stays
# off, same as every other unconfigured piece here.
VITE_FIREBASE_MEASUREMENT_ID=

# The Vercel deployment's URL once Phase 3 stands it up, e.g. https://zesto-api.vercel.app
# — unset/empty is fine before then; notification device-registration just no-ops.
VITE_API_BASE_URL=

# Public support contact for Help & Feedback's WhatsApp deep link
# (docs/ANALYTICS_FEEDBACK_PLAN.md). Not a secret — same footing as the Firebase web
# config above. Digits only, country code first, no + or spaces (e.g. 91XXXXXXXXXX).
# Unset just means the feedback buttons don't render (nothing to link to).
VITE_WHATSAPP_NUMBER=
