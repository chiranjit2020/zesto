# Zesto runs fully offline with NO backend. Supabase is optional — set these to enable
# cross-device sync + accounts for personal data (pantry, history, favorites, plans).
# Only the anon key is ever exposed to the browser. Never put the service-role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- server-side only, for supabase/seed.mjs (keep out of the repo and the client) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
