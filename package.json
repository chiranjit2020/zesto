{
  "name": "zesto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tell Zesto your situation. Zesto tells you what you can eat.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
